DISCORD_TOKEN=your_bot_token_here

# Comma-separated list of guild IDs to sync slash commands to (Staff Server + Work Server)
# Example: GUILD_IDS=123456789012345678,987654321098765432
GUILD_IDS=your_staff_server_id,your_work_server_id

# Railway PostgreSQL — copy from Railway dashboard → your DB → Connect → DATABASE_URL
DATABASE_URL=postgresql://user:password@host.railway.app:5432/railway
